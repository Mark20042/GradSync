PORT=8001
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=yourapp
JWT_SECRET=your-secret-key-here

# AI Services
GEMINI_API_KEY=your-gemini-api-key
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Email Service
# In development (NODE_ENV=development): automatically uses Mailtrap if MAILTRAP_TOKEN is set
# In production (NODE_ENV=production): uses Gmail
# You can override by setting EMAIL_SERVICE=mailtrap or EMAIL_SERVICE=gmail
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=YourApp <your-email@gmail.com>

# Mailtrap (for testing emails in development)
# Sign up at https://mailtrap.io and get your API token from https://mailtrap.io/api-tokens
# Get your inbox ID from your Mailtrap inbox URL (e.g., https://mailtrap.io/inboxes/123456/messages)
# When NODE_ENV=development and this token is set, emails automatically go to Mailtrap sandbox
MAILTRAP_TOKEN=your-mailtrap-api-token
MAILTRAP_INBOX_ID=your-inbox-id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
